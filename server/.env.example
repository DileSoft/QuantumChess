# Домен, на который выпущены сертификаты.
# Должен совпадать с именем каталога в /etc/letsencrypt/live/ на хосте.
# Если оставить пустым (и/или без сертификатов) — nginx поднимется
# в plain HTTP режиме на HTTP_PORT без SSL.
DOMAIN=

# Папка Let's Encrypt на хосте. Монтируется в контейнер nginx
# read-only как /etc/letsencrypt.
# Можно оставить пустой, если HTTPS не нужен.
LETSENCRYPT_DIR=

# Путь PeerServer. Должен совпадать с path в клиенте (VITE_PEER_PATH
# или настройка в Lobby).
PEER_PATH=/peerjs

# Ключ PeerServer. Должен совпадать с key в клиенте.
PEER_KEY=peerjs

# Публикуемые порты nginx (хост:контейнер = порт:80/443).
# Порт самого PeerServer (9000) наружу не публикуется —
# доступен только внутри docker-сети через nginx.
HTTP_PORT=9000
HTTPS_PORT=9002
