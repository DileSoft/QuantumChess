# PeerJS signaling server for online play.
# Default (when VITE_PEER_HOST is empty/unset) is wss://dilesoft.ru:9002/peerjs.
# Override here to use another server (see server/).
# If the configured server is unreachable, the client automatically
# falls back to the PeerJS public cloud broker.
VITE_PEER_HOST=dilesoft.ru
VITE_PEER_PORT=9002
VITE_PEER_PATH=/peerjs
VITE_PEER_KEY=peerjs
VITE_PEER_SECURE=true
